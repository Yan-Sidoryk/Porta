SHELLY_HOST=shelly-XX-eu.shelly.cloud
SHELLY_AUTH_KEY=replace-me-never-commit-the-real-one
SHELLY_DEVICE_ID=replace-me
JWT_SECRET=replace-me-min-32-chars
GATE_COOLDOWN_MS=5000
DATABASE_PATH=./gate.db
PUBLIC_URL=http://localhost:3000
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# --- Gate position sensor (reed contact on the Shelly Plus Add-on) ---
# The Add-on's input, from Shelly.GetStatus. Typically 100, never 0 -- input:0
# is the device's own terminal, wired to the gate board, not the magnet.
SHELLY_INPUT_COMPONENT_ID=100
# Its own secret, shared with nothing on the trigger path: this token can only
# report a position and must never be able to open a gate.
# Generate with: openssl rand -hex 32
# HEX, not base64: this token travels in a URL path segment, and standard
# base64 can contain '/', which would split the path and never match.
GATE_STATE_WEBHOOK_TOKEN=replace-me-openssl-rand-hex-32
# Five missed polls before the app is told the reading can no longer be trusted.
GATE_STATE_STALE_AFTER_MS=300000
GATE_STATE_POLL_INTERVAL_MS=60000
# One direct read this long after a pulse, catching a dropped webhook in
# seconds instead of whenever the 60s interval next comes round. Must clear
# the gate's travel: measured at ~12s to close, and the magnet clears ~3.8s
# into an opening. Reading earlier reports 'closed' for a gate already
# swinging open, which is worse than reporting nothing.
GATE_STATE_SETTLE_AFTER_MS=20000
# Flip if the multimeter says the NC leg reads the other way round. 'true' or
# 'false' only -- a typo is a refusal to boot, not a gate reporting backwards.
REED_LOGIC_INVERTED=false
